{
  "name": "maid-cafe-vsc",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "aon-co-jp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test test/core.test.js",
    "test:vscode": "tsc -p . && node test/vscode/runTest.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "maidCafe.paintSelection",
        "title": "%cmd.paintSelection%"
      },
      {
        "command": "maidCafe.askAboutColor",
        "title": "%cmd.askAboutColor%"
      },
      {
        "command": "maidCafe.askSelection",
        "title": "%cmd.askSelection%"
      },
      {
        "command": "maidCafe.followUp",
        "title": "%cmd.followUp%"
      },
      {
        "command": "maidCafe.explain",
        "title": "%cmd.explain%"
      },
      {
        "command": "maidCafe.fix",
        "title": "%cmd.fix%"
      },
      {
        "command": "maidCafe.writeTests",
        "title": "%cmd.writeTests%"
      },
      {
        "command": "maidCafe.clearColors",
        "title": "%cmd.clearColors%"
      },
      {
        "command": "maidCafe.setApiKey",
        "title": "%cmd.setApiKey%"
      },
      {
        "command": "maidCafe.selectProvider",
        "title": "%cmd.selectProvider%"
      },
      {
        "command": "maidCafe.aiLogin",
        "title": "%cmd.aiLogin%"
      },
      {
        "command": "maidCafe.aiLogout",
        "title": "%cmd.aiLogout%"
      },
      {
        "command": "maidCafe.openQA",
        "title": "%cmd.openQA%"
      },
      {
        "command": "maidCafe.openSchool",
        "title": "%cmd.openSchool%"
      },
      {
        "command": "maidCafe.openArurau",
        "title": "%cmd.openArurau%"
      },
      {
        "command": "maidCafe.project.import",
        "title": "%cmd.project.import%"
      },
      {
        "command": "maidCafe.project.step",
        "title": "%cmd.project.step%"
      },
      {
        "command": "maidCafe.selectThirdLanguage",
        "title": "%cmd.selectThirdLanguage%"
      },
      {
        "command": "maidCafe.translateSelection",
        "title": "%cmd.translateSelection%"
      },
      {
        "command": "maidCafe.englishCafe",
        "title": "%cmd.englishCafe%"
      },
      {
        "command": "maidCafe.englishCafe.reset",
        "title": "%cmd.englishCafe.reset%"
      },
      {
        "command": "maidCafe.welcome",
        "title": "%cmd.welcome%"
      },
      {
        "command": "maidCafe.project.dropPanel",
        "title": "%cmd.dropPanel%"
      },
      {
        "command": "maidCafe.project.importDropped",
        "title": "%cmd.importDropped%"
      },
      {
        "command": "maidCafe.project.survey",
        "title": "%cmd.survey%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "maidCafe.paintSelection",
          "when": "editorHasSelection",
          "group": "maidCafe@1"
        },
        {
          "command": "maidCafe.askSelection",
          "when": "editorHasSelection",
          "group": "maidCafe@2"
        },
        {
          "command": "maidCafe.explain",
          "when": "editorHasSelection",
          "group": "maidCafe@3"
        },
        {
          "command": "maidCafe.fix",
          "when": "editorHasSelection",
          "group": "maidCafe@4"
        },
        {
          "command": "maidCafe.writeTests",
          "when": "editorHasSelection",
          "group": "maidCafe@5"
        },
        {
          "command": "maidCafe.askAboutColor",
          "group": "maidCafe@6"
        },
        {
          "command": "maidCafe.translateSelection",
          "when": "editorHasSelection",
          "group": "maidCafe@7"
        }
      ],
      "explorer/context": [
        {
          "command": "maidCafe.project.import",
          "when": "resourceExtname =~ /\\.(md|markdown|txt|docx|pdf)$/",
          "group": "maidCafe@1"
        }
      ],
      "commandPalette": [
        {
          "command": "maidCafe.project.importDropped",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "maidCafe.paintSelection",
        "key": "ctrl+alt+m",
        "when": "editorHasSelection"
      },
      {
        "command": "maidCafe.askSelection",
        "key": "ctrl+alt+q",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Maid Cafe Code Helper",
      "properties": {
        "maidCafe.provider": {
          "type": "string",
          "default": "aruaru",
          "enum": [
            "aruaru",
            "openai",
            "gemini",
            "deepseek",
            "grok",
            "claude"
          ],
          "description": "AI provider. aruaru = aruaru-search + aruaru-llm (free)."
        },
        "maidCafe.models": {
          "type": "object",
          "default": {},
          "description": "Model id per provider, e.g. {\"openai\": \"gpt-5\"}. Empty = built-in default."
        },
        "maidCafe.aruaruUrl": {
          "type": "string",
          "default": "https://maid-cafe.tokyo",
          "description": "Base URL of the free aruaru-llm / aruaru-search service (Connect calls)."
        },
        "maidCafe.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask keys, tokens and passwords in code before it is sent."
        },
        "maidCafe.confirmBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "Show what will be sent and ask before every request."
        },
        "maidCafe.maxContextChars": {
          "type": "number",
          "default": 12000,
          "description": "Maximum characters of code sent per request."
        },
        "maidCafe.arurauPageUrl": {
          "type": "string",
          "default": "https://audiocafe.tokyo/aruaru",
          "description": "arurau on audiocafe.tokyo: an IT engineer job / project matching page (freelance, dispatch, employee). Opened by the command 'Maid Cafe: Open audiocafe.tokyo arurau'."
        },
        "maidCafe.redactPersonal": {
          "type": "boolean",
          "default": true,
          "description": "Mask names, contact details and pay/rates in imported job/project material before it is sent to an AI."
        },
        "maidCafe.learningMode": {
          "type": "boolean",
          "default": true,
          "description": "Learning mode: each project step also explains briefly why it is done that way."
        },
        "maidCafe.thirdLanguage": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "ja",
            "en",
            "zh",
            "ko",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "ru",
            "uk",
            "pl",
            "nl",
            "sv",
            "da",
            "fi",
            "cs",
            "el",
            "hu",
            "ro",
            "tr",
            "ar",
            "fa",
            "he",
            "hi",
            "bn",
            "ta",
            "ur",
            "th",
            "vi",
            "id",
            "ms",
            "tl",
            "sw",
            "af",
            "my",
            "km",
            "ne",
            "mn"
          ],
          "description": "Third language besides Japanese and English. When set, every AI answer and English-conversation reply is also translated into it, as a native speaker would write (free: aruaru-llm translation worker, M2M100 418M, MIT; paid: your own provider key). Empty = off."
        },
        "maidCafe.translateFallbackProvider": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "openai",
            "gemini",
            "deepseek",
            "grok",
            "claude"
          ],
          "description": "When the free translation or conversation looks poor, retry with this provider using your own saved API key (set it with 'Maid Cafe: Set an AI provider API key'). Empty = never."
        },
        "maidCafe.englishLevel": {
          "type": "string",
          "default": "beginner",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "description": "English level of the maid-cafe conversation."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "maidCafe.welcome",
        "title": "%wt.title%",
        "description": "%wt.desc%",
        "steps": [
          {
            "id": "color",
            "title": "%wt.color.title%",
            "description": "%wt.color.desc%",
            "media": {
              "markdown": "walkthrough/color.md"
            },
            "completionEvents": [
              "onCommand:maidCafe.paintSelection"
            ]
          },
          {
            "id": "ask",
            "title": "%wt.ask.title%",
            "description": "%wt.ask.desc%",
            "media": {
              "markdown": "walkthrough/ask.md"
            },
            "completionEvents": [
              "onCommand:maidCafe.askSelection"
            ]
          },
          {
            "id": "provider",
            "title": "%wt.provider.title%",
            "description": "%wt.provider.desc%",
            "media": {
              "markdown": "walkthrough/provider.md"
            },
            "completionEvents": [
              "onCommand:maidCafe.selectProvider"
            ]
          },
          {
            "id": "project",
            "title": "%wt.project.title%",
            "description": "%wt.project.desc%",
            "media": {
              "markdown": "walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:maidCafe.project.import"
            ]
          },
          {
            "id": "english",
            "title": "%wt.english.title%",
            "description": "%wt.english.desc%",
            "media": {
              "markdown": "walkthrough/english.md"
            },
            "completionEvents": [
              "onCommand:maidCafe.englishCafe"
            ]
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "maidCafe.dropZone",
          "name": "%view.dropZone%"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.11",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aon-co-jp/maid-cafe-vsc.git"
  }
}
